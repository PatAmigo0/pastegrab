# Build-time secrets. Fill a copy named secrets.toml, which git ignores.
# Without secrets.toml the build still works, and his reports stay on his PC.

[telegram]
# From BotFather: digits, a colon, then the secret part.
token = ""
# Your chat with the bot: send the bot any message, then read message.chat.id from
# https://api.telegram.org/bot<token>/getUpdates
chat_id = 0
