        <PathAndCredentials wcm:action="add" wcm:keyValue="1"><Path>D:\vioscsi\w8\amd64</Path></PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="2"><Path>E:\vioscsi\w8\amd64</Path></PathAndCredentials>
