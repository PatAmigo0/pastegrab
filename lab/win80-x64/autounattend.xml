        <PathAndCredentials wcm:action="add" wcm:keyValue="6"><Path>E:\NetKVM\w8\amd64</Path></PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="7"><Path>F:\NetKVM\w8\amd64</Path></PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="8"><Path>G:\NetKVM\w8\amd64</Path></PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="9"><Path>D:\vioserial\w8\amd64</Path></PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="10"><Path>E:\vioserial\w8\amd64</Path></PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="11"><Path>F:\vioserial\w8\amd64</Path></PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="12"><Path>G:\vioserial\w8\amd64</Path></PathAndCredentials>
