        <PathAndCredentials wcm:action="add" wcm:keyValue="14"><Path>E:\Balloon\w8\amd64</Path></PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="15"><Path>F:\Balloon\w8\amd64</Path></PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="16"><Path>G:\Balloon\w8\amd64</Path></PathAndCredentials>
